# ============================================================
# INSTAGRAM SCRAPER - VARIABLES DE ENTORNO (.env)
# ============================================================
# Copia este archivo con el nombre '.env' y rellena tus datos.
# NUNCA subas tu archivo .env real a repositorios públicos.

# Usuario objetivo a raspar (sin @)
TARGET_USER=sausage_player

# Cookies de sesión extraídas desde tu navegador (Brave, Chrome o Firefox):
# 1. Abre tu navegador y ve a https://www.instagram.com
# 2. Presiona F12 -> Pestaña Application (o Almacenamiento) -> Cookies -> https://www.instagram.com
# 3. Copia los valores correspondientes:
IG_SESSIONID=tu_sessionid_aqui
IG_DS_USER_ID=tu_ds_user_id_aqui
IG_CSRFTOKEN=tu_csrftoken_aqui

# Opcional: User Agent de tu navegador
IG_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
